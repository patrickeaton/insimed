{
  "name": "insim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "sst dev",
    "deploy": "sst deploy",
    "deploy:prod": "sst deploy --stage production",
    "remove": "sst remove",
    "marketing:dev": "pnpm --filter @insim/marketing dev",
    "marketing:build": "pnpm --filter @insim/marketing build",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "sst": "^3.17.0",
    "typescript": "^5.7.3"
  }
}
